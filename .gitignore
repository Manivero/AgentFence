# Rust
/target/
**/*.rs.bk

# NOTE: Cargo.lock is intentionally tracked. AgentFence is a security product;
# the exact dependency set must be reproducible from the repository rather than
# re-resolved on every build.
#
# The standalone guest fixtures and the excluded web-ui crate are regenerated by
# their own build scripts, so their lockfiles are build artifacts.
/crates/wasm-plugin/guest/Cargo.lock
/crates/wasm-plugin/guest-hostcaps/Cargo.lock
/web-ui/src-tauri/Cargo.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Runtime data
*.db
*.jsonl
/audit/
/logs/
/web-ui/node_modules/
/web-ui/dist/
/web-ui/src-tauri/target/

# Environment
.env
.env.local

# Build artifacts
dist/
build/

# WASM plugin guest fixtures are standalone crates; their build output is
# regenerable via crates/wasm-plugin/build-fixtures.sh and must not be committed.
/crates/wasm-plugin/guest/target/
/crates/wasm-plugin/guest-hostcaps/target/
