# AgentFence container execution backend configuration.
#
# Copy to your environment or source it before running agentguard.
# The backend is selected once per invocation; there is no host fallback.

# `host` runs commands directly (the default).
# `container` runs commands inside an isolated container.
export AGENTFENCE_EXECUTION_BACKEND=container

# Docker-compatible runtime. `docker` or `podman`.
export AGENTFENCE_CONTAINER_RUNTIME=docker

# Optional: explicit runtime executable path. When unset, PATH is searched.
# export AGENTFENCE_CONTAINER_RUNTIME_PATH=/usr/local/bin/docker

# Image used for every execution.
export AGENTFENCE_CONTAINER_IMAGE=alpine:latest

# Resource ceilings.
export AGENTFENCE_CONTAINER_MAX_CPU=1.0
export AGENTFENCE_CONTAINER_MAX_MEMORY_MB=512
export AGENTFENCE_CONTAINER_PIDS_LIMIT=256

# Wall-clock timeout. A timed-out container is killed and removed.
export AGENTFENCE_CONTAINER_TIMEOUT_SECS=300

# Non-root execution. uid 0 is rejected.
export AGENTFENCE_CONTAINER_RUN_AS_UID=1000
export AGENTFENCE_CONTAINER_RUN_AS_GID=1000

# `none` disables all container networking.
export AGENTFENCE_CONTAINER_NETWORK=none

# `true` mounts the container root filesystem read-only.
export AGENTFENCE_CONTAINER_READ_ONLY=true
